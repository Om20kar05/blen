{
  "name": "blen-digital-hr-system",
  "version": "1.0.0",
  "description": "BLEN DIGITAL - Employee Leave & Attendance Management System (MERN Stack)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/src/server.js",
    "postinstall": "npm --prefix backend install",
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "test:all": "npm --prefix backend run test:all",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:dev": "npm --prefix frontend run dev"
  },
  "keywords": [
    "mern",
    "attendance-management",
    "leave-management",
    "rbac",
    "mongodb",
    "express",
    "react",
    "node"
  ],
  "author": "BLEN Candidate",
  "license": "ISC"
}
